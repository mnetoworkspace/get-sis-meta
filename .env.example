# Supabase — projeto criado em https://supabase.com
# Usar a Service Role Key aqui (não a anon key). Este projeto acessa o banco
# apenas server-side (route handlers do Next.js), então a service role fica segura.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Versão da Graph API da Meta a ser usada nas chamadas
META_GRAPH_API_VERSION=v21.0

# Login único do painel (portão de acesso, não é multi-usuário).
# Se omitidas, caem nos padrões abaixo.
APP_LOGIN_USER=rakebet
APP_LOGIN_PASSWORD=rkbt123

# Fathom Analytics (tráfego do site) — https://app.usefathom.com/settings/api
FATHOM_API_TOKEN=
FATHOM_SITE_ID=

# Notificações push de depósito (Web Push / VAPID).
# Gerar um par novo com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@rakebet.io
# Mesma chave pública acima — precisa do prefixo NEXT_PUBLIC_ pra chegar no navegador.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# A partir de quantos minutos sem nenhum depósito novo dispara o alerta de
# silêncio (possível problema no gateway de pagamento). Padrão: 60.
DEPOSIT_SILENCE_MINUTES=60
# De quanto em quanto tempo o agendador interno checa depósitos novos/silêncio.
# Padrão: 5.
DEPOSIT_CHECK_INTERVAL_MINUTES=5
